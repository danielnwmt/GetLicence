# Copie para .env e ajuste os valores
POSTGRES_PASSWORD=trocar-senha-banco-segura
# Segredo HS256 para assinar tokens JWT (mínimo 32 chars). Gere com: openssl rand -hex 32
JWT_SECRET=trocar-este-segredo-jwt-32-caracteres-no-minimo-xx

# URL pública onde o app fica acessível (sem barra no final)
SITE_URL=http://localhost:8000
HTTP_PORT=8000

# Admin inicial (criado no boot pelo db/init/03_admin.sql se não existir)
ADMIN_EMAIL=admin@getlicence.com
ADMIN_PASSWORD=admin1234

# SMTP opcional (deixe vazio se não for usar verificação de email)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Axis Licencas

# Chaves anon/service emitidas a partir do JWT_SECRET acima.
# Gere com:  cd local && bash gen-keys.sh
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
