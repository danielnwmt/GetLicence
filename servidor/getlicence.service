[Unit]
Description=GetLicence (self-hosted)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/getlicence
EnvironmentFile=/opt/getlicence/.env
ExecStart=/usr/bin/node /opt/getlicence/dist/server.js
Restart=on-failure
RestartSec=5
User=root
Group=root
# Hardening básico
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
