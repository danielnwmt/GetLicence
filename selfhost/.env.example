# Porta HTTP do servidor
PORT=3000
NODE_ENV=production

# Banco Postgres local (preenchido pelo install.sh)
DATABASE_URL=postgres://axis_user:CHANGE_ME@127.0.0.1:5432/axis_db

# Segredo para assinar JWT de sessão (mínimo 32 chars). O install.sh gera um aleatório.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Admin inicial criado no primeiro boot (somente se nenhum admin existir)
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_PASSWORD=trocar-na-primeira-instalacao
ADMIN_NAME=Administrador

# Pagamentos (preencha apenas o provedor que for usar)
ASAAS_API_KEY=
ASAAS_ENV=sandbox

SICREDI_CLIENT_ID=
SICREDI_CLIENT_SECRET=
SICREDI_CERT_PEM=
SICREDI_CERT_KEY=

SICOOB_CLIENT_ID=
SICOOB_ACCESS_TOKEN=
SICOOB_CERT_PEM=
SICOOB_CERT_KEY=
